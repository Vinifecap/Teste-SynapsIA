# SynapsIA - Variaveis de ambiente locais
# Copie este arquivo para .env e ajuste se necessario.

# API configuration (backend)
HOST=127.0.0.1
PORT=8000

# Frontend Vite
VITE_API_BASE_URL=http://localhost:8000

# fMRI processing settings
FMRI_SMOOTHING_FWHM=6
FMRI_MIN_VOLUMES=10
FMRI_ANOMALY_THRESHOLD=2.0
FMRI_TR=2.0

# Temp storage (relative to backend dir)
UPLOAD_DIR=temp_uploads
MPLCONFIGDIR=.matplotlib_cache
