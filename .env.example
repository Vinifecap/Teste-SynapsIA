# SynapsIA — Environment Variables
# Copy this file to .env and fill in the values

# API configuration (backend)
HOST=0.0.0.0
PORT=8000

# fMRI processing settings
FMRI_SMOOTHING_FWHM=6       # Spatial smoothing kernel (mm)
FMRI_MIN_VOLUMES=10         # Minimum required time volumes
FMRI_ANOMALY_THRESHOLD=2.0  # Z-score threshold for anomaly detection
FMRI_TR=2.0                 # Repetition time (seconds) — used when not in NIfTI header

# Temp storage (relative to backend dir)
UPLOAD_DIR=temp_uploads
